diff --git a/FluidNC/esp32/tmc_spi_support.c b/FluidNC/esp32/tmc_spi_support.c
--- a/FluidNC/esp32/tmc_spi_support.c
+++ b/FluidNC/esp32/tmc_spi_support.c
@@ -69,6 +69,11 @@ void tmc_spi_transfer_data(const uint8_t* out, int out_bitlen, uint8_t* in, int in_bi
     spi_ll_clear_int_stat(hw);
 #if ESP_IDF_VERSION_MAJOR < 5
     spi_ll_master_user_start(hw);
+#else
+    // IDF 5 split configuration latching from starting the transaction.
+    // Clearing trans_done without starting would block forever below.
+    spi_ll_apply_config(hw);
+    spi_ll_user_start(hw);
 #endif
     while (!spi_ll_usr_is_done(hw)) {}
 
